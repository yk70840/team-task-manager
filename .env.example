
# Copy this file to .env and fill in your values.
#   cp .env.example .env

# A long, random secret used to sign session cookies.
SECRET_KEY=supersecret-change-me-in-production

# Port the app listens on (Docker host port and uvicorn port).
# Railway sets this automatically; change it here for local Docker.
PORT=8765

# Set to 1 to print all SQL queries to stdout (useful for local debugging).
DB_ECHO=0

# Password for the PostgreSQL user (used by both the db and web services).
DB_PASSWORD=ttm_password

# PostgreSQL (Docker / production):
# DATABASE_URL=postgresql+asyncpg://ttm_user:ttm_password@db:5432/team_task_manager
# SQLite (local development, no Docker):
DATABASE_URL=sqlite+aiosqlite:///./team_task_manager.db
